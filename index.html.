<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>VibeCut Edits</title>
  <style>
    body {
      margin: 0;
      font-family: 'Segoe UI', sans-serif;
      background-color: #0f0f0f;
      color: #ffffff;
    }
    .banner img {
      width: 100%;
      height: auto;
      display: block;
      border-radius: 12px;
      box-shadow: 0 4px 25px rgba(0, 0, 0, 0.6);
      margin-bottom: 20px;
    }
    header {
      text-align: center;
      padding: 20px;
    }
    h1 {
      font-size: 2.5em;
      margin: 10px 0 5px;
    }
    p.tagline {
      font-size: 1.2em;
      color: #ccc;
      margin-bottom: 30px;
    }
    .section {
      padding: 20px;
      text-align: center;
    }
    .section h2 {
      font-size: 1.8em;
      margin-bottom: 15px;
      color: #00ffff;
    }
    .services ul {
      list-style: none;
      padding: 0;
    }
    .services li {
      font-size: 1.1em;
      margin: 10px 0;
    }
    .contact a {
      color: #00acee;
      text-decoration: none;
    }
    .button {
      display: inline-block;
      margin-top: 20px;
      padding: 12px 24px;
      font-size: 1em;
      background-color: #00acee;
      color: #fff;
      border: none;
      border-radius: 8px;
      text-decoration: none;
      transition: background 0.3s ease;
    }
    .button:hover {
      background-color: #008ac7;
    }
    form {
      max-width: 400px;
      margin: 0 auto;
      text-align: left;
    }
    input, textarea {
      width: 100%;
      padding: 10px;
      margin: 8px 0;
      border-radius: 6px;
      border: none;
      background-color: #222;
      color: #fff;
    }
    input::placeholder, textarea::placeholder {
      color: #aaa;
    }
    footer {
      text-align: center;
      padding: 10px;
      background-color: #1a1a1a;
      border-top: 1px solid #333;
      color: #999;
      margin-top: 30px;
    }
    @media (max-width: 600px) {
      h1 {
        font-size: 2em;
      }
      .section h2 {
        font-size: 1.5em;
      }
    }
  </style>
</head>
<body>

  <div class="banner">
    <img src="banner.jpg" alt="VibeCut Edits Banner" />
  </div>

  <header>
    <h1>VibeCut Edits</h1>
    <p class="tagline">Edit For Your Shine</p>
    <a href="#contact-form" class="button">Hire Us</a>
  </header>

  <div class="section services">
    <h2>Our Services</h2>
    <ul>
      <li>Editing YouTube Shorts & Long Videos</li>
      <li>Reels Editing (Instagram, Facebook)</li>
      <li>Color Grading and Transitions</li>
      <li>Luxury Style and Modern Aesthetic</li>
      <li>Quick Delivery and Professional Quality</li>
    </ul>
  </div>

  <div class="section contact">
    <h2>Contact Info</h2>
    <p>Email: <a href="mailto:vibecutedits@gmail.com">vibecutedits@gmail.com</a></p>
    <p>Instagram: <a href="https://instagram.com/vibecut18" target="_blank">@vibecut18</a></p>
  </div>

  <div class="section" id="contact-form">
    <h2>Send Us a Message</h2>
    <form>
      <input type="text" name="name" placeholder="Your Name" required />
      <input type="email" name="email" placeholder="Your Email" required />
      <textarea name="message" rows="5" placeholder="Your Message" required></textarea>
      <button class="button" type="submit">Send</button>
    </form>
  </div>

  <footer>
    &copy; 2025 VibeCut Edits. All rights reserved.
  </footer>

</body>
</html>